# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Virtual environments ────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Packaging / build ───────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/
# NOTE: Sincronizador.spec is committed on purpose (build recipe) — do NOT ignore *.spec

# ── Test / lint / type caches ───────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Secrets & runtime config ────────────────────────────────────────
